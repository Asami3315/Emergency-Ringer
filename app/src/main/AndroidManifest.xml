<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission to intercept notifications (required for NotificationListenerService) -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <!-- Permission to bypass Do Not Disturb -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Permission to modify audio (ringer mode, volume) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Permission to read contacts for whitelist picker -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Optional: Wake lock to ensure alarm plays with screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Permission to detect call state (pickup/end) to auto-stop alarm -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Android 13+ only needs this lighter permission -->
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />

    <!-- Optional: Request to ignore battery optimization for reliability -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="ProtectedPermissions" />
    
    <!-- Permission for vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Foreground service — keeps the notification listener alive on MIUI/aggressive OEMs -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:ignore="ProtectedPermissions" />
    
    <!-- Permission for flashlight strobe -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />

    <!-- Permission to detect call state (for auto-stopping ringer) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Android 13+ requires READ_BASIC_PHONE_STATE for call state -->
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:name=".EmergencyRingerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmergencyRinger"
        tools:targetApi="34">

        <activity
            android:name=".SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.EmergencyRinger.Splash" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EmergencyRinger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".NotificationService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Emergency call monitoring" />
        </service>
        
        <!-- Quick Settings Tile Service -->
        <service
            android:name=".ProtectionTileService"
            android:exported="true"
            android:icon="@drawable/ic_clock"
            android:label="Emergency Ringer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Fallback: BroadcastReceiver for direct PHONE_STATE trigger -->
        <!-- Fires for all incoming calls even if NotificationListenerService is disconnected -->
        <receiver
            android:name=".CallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
