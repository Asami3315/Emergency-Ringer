<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme — windowBackground matches NeoBackground so no black flash -->
    <style name="Theme.EmergencyRinger" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">#FFB703</item>
        <item name="android:colorPrimaryDark">#E6A200</item>
        <!-- Matches NeoBackground (#FAFAFA) — eliminates black flash on MainActivity startup -->
        <item name="android:windowBackground">#FAFAFA</item>
    </style>

    <!-- Splash theme — amber background so no black flash during SplashActivity startup -->
    <style name="Theme.EmergencyRinger.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#FFB703</item>
        <item name="android:navigationBarColor">#FF9500</item>
        <item name="android:windowBackground">#FFB703</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
